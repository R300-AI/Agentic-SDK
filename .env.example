# Agentic SDK 配置範本
# 使用方式:cp .env.example .env,再填入實際值。.env 已被 .gitignore 排除,不會進入版本控制。

# ─────────────────────────────────────────────────────────────────────
# Gateway 自身
# ─────────────────────────────────────────────────────────────────────
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080

# ─────────────────────────────────────────────────────────────────────
# Dashboard(Streamlit;與 Gateway 同 venv 但獨立行程)
# DASHBOARD_REFRESH_SEC:面板輪詢 /internal/telemetry/snapshot 的週期
# DASHBOARD_SNAPSHOT_LIMIT:每次拉取最近 N 筆事件
# ─────────────────────────────────────────────────────────────────────
DASHBOARD_PORT=8501
DASHBOARD_REFRESH_SEC=2
DASHBOARD_SNAPSHOT_LIMIT=500

# ─────────────────────────────────────────────────────────────────────
# 上游 AMD NPU 推論伺服器(amd-ryzen-ai-benchmark / api.py)
# Gateway 代理此來源,Action 節點亦呈繳推理至此
# ─────────────────────────────────────────────────────────────────────
UPSTREAM_API_BASE_URL=http://localhost:8000/v1
UPSTREAM_API_KEY=not-needed
UPSTREAM_HEALTHCHECK_TIMEOUT_SEC=5

# ─────────────────────────────────────────────────────────────────────
# Azure AI Foundry deployment(供 Plan / Reflect 節點直接呼叫)
# Gateway 不代理此來源 — 由節點實作自行透過 openai SDK 呼叫
# ─────────────────────────────────────────────────────────────────────
AZURE_FOUNDRY_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=gpt-4o-mini
AZURE_FOUNDRY_API_VERSION=2024-12-01-preview

# ─────────────────────────────────────────────────────────────────────
# 推論逾時(共用)
# ─────────────────────────────────────────────────────────────────────
INFER_REQUEST_TIMEOUT_SEC=120

# ─────────────────────────────────────────────────────────────────────
# Workflow(Phase 2 五節點)
# WORKFLOW_MAX_NODE_HOPS:單次 Workflow.run() 全域節點執行次數上限
# WORKFLOW_MAX_REVISIT:同一節點重複進入次數上限
# WORKFLOW_TIMEOUT_SEC:單次工作流 wall-clock 上限(同步檢查,P99 中止)
# WORKFLOW_FORCE_MOCK_FOUNDRY:true 時即使有 AZURE_FOUNDRY_API_KEY 也用 mock
#   Foundry(影響 Plan/Reflect),適合離線示範與 CI;未設時若 API_KEY 為空也會
#   自動 mock
# WORKFLOW_ACTION_BACKEND:Action 節點呼叫對象
#   - upstream(預設,正式部署):打 UPSTREAM_API_BASE_URL 指向的 AMD NPU,
#     此模式 Gateway 會做上游 healthcheck
#   - foundry(本機開發 / 無 Ryzen AI 機台時):Action 直接打 Azure Foundry
#     deployment,免架上游;此模式跳過上游 healthcheck
# ─────────────────────────────────────────────────────────────────────
WORKFLOW_MAX_NODE_HOPS=50
WORKFLOW_MAX_REVISIT=5
WORKFLOW_TIMEOUT_SEC=30
WORKFLOW_FORCE_MOCK_FOUNDRY=false
WORKFLOW_ACTION_BACKEND=upstream

# ─────────────────────────────────────────────────────────────────────
# Active / Archived Context(A-04 / A-07 Phase 2)
# ACTIVE_CONTEXT_MAX_MB:in-memory 上限,逾此值依 LRU 降級至 archived
# CONTEXT_IDLE_DEMOTE_SEC:條目閒置逾此秒數,讀取時觸發降級
# CONTEXT_HARD_TTL_SEC:從 created_at 起算的硬性 TTL
# ARCHIVED_CONTEXT_DIR:archived JSONL 落地目錄(相對於 Gateway cwd)
# ─────────────────────────────────────────────────────────────────────
ACTIVE_CONTEXT_MAX_MB=8
CONTEXT_IDLE_DEMOTE_SEC=300
CONTEXT_HARD_TTL_SEC=3600
ARCHIVED_CONTEXT_DIR=.archived_context

# ─────────────────────────────────────────────────────────────────────
# 上游週期性健康檢查(M2-2 Dashboard 觀測-1 即時更新依據)
# ─────────────────────────────────────────────────────────────────────
UPSTREAM_HEALTH_POLL_SEC=5

# ─────────────────────────────────────────────────────────────────────
# 遙測(Phase 1 採記憶體環形緩衝 + 可選 JSONL 落地)
# TELEMETRY_BUFFER_SIZE:Gateway 內 ring buffer 上限事件數
# TELEMETRY_JSONL_PATH:留空 = 不寫盤;填路徑則同步寫入單行 JSON
# ─────────────────────────────────────────────────────────────────────
TELEMETRY_BUFFER_SIZE=2000
TELEMETRY_JSONL_PATH=
